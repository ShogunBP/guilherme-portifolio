{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.80",
          "--browser",
          "chrome",
          "--executable-path",
          "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
          "--block-service-workers",
          "--isolated",
          "--image-responses",
          "omit"
        ],
        "codemode": true,
        "timeout": {
          "startup": 120000,
          "catalog": 30000,
          "execution": 120000
        }
      }
    }
  }
}
